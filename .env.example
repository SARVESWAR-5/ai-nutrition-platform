# ==============================================================================
# PERSONAL AI NUTRITION PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT SECURITY & PRIVACY NOTICE:
# 1. Never commit real keys or secrets to version control.
# 2. PRIVACY WARNING (Gemini Free Tier): The free tier of the Gemini API may
#    use submitted prompts and responses to improve Google products.
#    For personal health and dietary data, obtain a paid-tier Gemini key or
#    verify the current terms of service at https://ai.google.dev/terms
# 3. Server-side only variables must NEVER have the NEXT_PUBLIC_ prefix.
# ==============================================================================

# NEXT.JS CORE
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# SUPABASE (Database, Auth & Storage)
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# GOOGLE GEMINI AI (@google/genai)
# Server-side only. Get key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# NUTRITION DATA SOURCES
# USDA FoodData Central (Free API key at https://api.data.gov/signup/)
USDA_API_KEY=DEMO_KEY

# APPLICATION DEFAULTS
DEFAULT_TIMEZONE=Asia/Kolkata
